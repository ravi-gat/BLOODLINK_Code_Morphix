# BloodLink Frontend — Environment Variables
# Copy this file to .env and set values before running the dev server.
# NEVER commit .env to version control.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Google Maps JavaScript API key
# Enable in Google Cloud Console (console.cloud.google.com):
#   - Maps JavaScript API
#   - Places API (New)
#   - Geocoding API
VITE_GOOGLE_MAPS_API_KEY=
