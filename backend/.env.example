# ─────────────────────────────────────────────────────────────────────────────
# BloodLink Backend — Environment Variables
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/bloodlink

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string-minimum-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BCRYPT_ROUNDS=12
ENVIRONMENT=development
DEBUG=false

# ── SMTP / Email ─────────────────────────────────────────────────────────────
# Gmail SMTP requires an App Password (NOT your regular Gmail password).
# Enable 2-Step Verification, then create an App Password at:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-app-password-16-chars
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=BloodLink Healthcare Network

# ── Email Verification ────────────────────────────────────────────────────────
# Set to true once SMTP is confirmed working.
# When false, all new accounts are immediately ACTIVE (no verification step).
REQUIRE_EMAIL_VERIFICATION=true

# ── Google Maps API ──────────────────────────────────────────────────────────
# Required for server-side geocoding of facility addresses.
# Enable in Google Cloud Console:
#   - Geocoding API
#   - Routes API (for distance/directions fallback)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
