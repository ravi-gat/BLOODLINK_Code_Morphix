# BloodLink FastAPI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloodlink

# ── JWT Authentication ────────────────────────────────────────────────────────
# Use a long random string (min 32 chars) for each secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# bcrypt cost factor — higher is more secure but slower (12 is recommended)
BCRYPT_ROUNDS=12

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
