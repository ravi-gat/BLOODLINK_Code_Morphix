generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  PATIENT
  DONOR
  HOSPITAL
  BLOOD_BANK
  ADMIN
}
enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}
enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}
enum RequestStatus {
  PENDING
  ACCEPTED
  PROCESSING
  FULFILLED
  REJECTED
  CANCELLED
}
enum EmergencyStatus {
  PENDING
  ACTIVE
  MATCHED
  FULFILLED
  CANCELLED
  EXPIRED
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 phone String
 role Role
 status UserStatus @default(ACTIVE)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 patient Patient?
 donor Donor?
 hospital Hospital?
 bloodBank BloodBank?
 notifications Notification[]
 auditLogs AuditLog[]
}
model Patient {
 id String @id @default(cuid())
 userId String @unique
 bloodGroup BloodGroup
 city String
 address String?
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 requests BloodRequest[]
 emergencyRequests EmergencyRequest[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Donor {
 id String @id @default(cuid())
 userId String @unique
 bloodGroup BloodGroup
 city String
 address String?
 availabilityStatus Boolean @default(true)
 lastDonationDate DateTime?
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 donations Donation[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([bloodGroup,city,availabilityStatus])
}
model Hospital {
 id String @id @default(cuid())
 userId String @unique
 hospitalName String
 registrationNumber String @unique
 city String
 address String?
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 requests BloodRequest[]
 emergencyRequests EmergencyRequest[]
 donations Donation[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model BloodBank {
 id String @id @default(cuid())
 userId String @unique
 name String
 registrationNumber String @unique
 city String
 address String?
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 inventory BloodInventory[]
 donations Donation[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model BloodInventory {
 id String @id @default(cuid())
 bloodBankId String
 bloodGroup BloodGroup
 unitsAvailable Int
 unitsReserved Int @default(0)
 expiryDate DateTime
 updatedAt DateTime @updatedAt
 bloodBank BloodBank @relation(fields:[bloodBankId], references:[id], onDelete:Cascade)
 @@index([bloodBankId,bloodGroup])
}
model BloodRequest {
 id String @id @default(cuid())
 patientId String?
 hospitalId String?
 bloodGroup BloodGroup
 unitsRequired Int
 urgency String
 status RequestStatus @default(PENDING)
 city String
 notes String?
 patient Patient? @relation(fields:[patientId], references:[id])
 hospital Hospital? @relation(fields:[hospitalId], references:[id])
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,city,bloodGroup])
}
model EmergencyRequest {
 id String @id @default(cuid())
 requesterId String
 hospitalId String?
 bloodGroup BloodGroup
 unitsRequired Int
 city String
 urgency String
 status EmergencyStatus @default(PENDING)
 requester Patient @relation(fields:[requesterId], references:[id])
 hospital Hospital? @relation(fields:[hospitalId], references:[id])
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Donation {
 id String @id @default(cuid())
 donorId String
 bloodBankId String?
 hospitalId String?
 bloodGroup BloodGroup
 units Int
 donationDate DateTime @default(now())
 status String
 donor Donor @relation(fields:[donorId], references:[id])
 bloodBank BloodBank? @relation(fields:[bloodBankId], references:[id])
 hospital Hospital? @relation(fields:[hospitalId], references:[id])
 createdAt DateTime @default(now())
}
model Notification {
 id String @id @default(cuid())
 userId String
 title String
 message String
 type String
 isRead Boolean @default(false)
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,isRead])
}
model AuditLog {
 id String @id @default(cuid())
 userId String?
 action String
 entity String
 entityId String?
 metadata Json?
 createdAt DateTime @default(now())
 user User? @relation(fields:[userId], references:[id])
 @@index([action,createdAt])
}
